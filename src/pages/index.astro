---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Projets from "../components/Projets.astro";
import trees from "../assets/trees.glb";
import branch from "../assets/branche.svg";
---
<Layout title="Acceuil" bodyClass="home-page">
    <section class="relative z-0 h-[65vh] min-h-[430px] w-full overflow-hidden sm:h-[75vh] lg:h-screen lg:col-span-11">
        <model-viewer
            class="absolute inset-x-0 top-0 z-0 block h-[calc(100%+40px)] w-full"
            src={trees}
            alt="Modèle 3D d'arbres"
            camera-controls
            camera-orbit="0deg 80deg 2m"
            camera-target="0m 0.4m 0m"
            min-camera-orbit="-8deg 76deg 2.5m"
            max-camera-orbit="8deg 80deg 2m"
            disable-zoom
            touch-action="pan-y"
            shadow-intensity="1"
        ></model-viewer>
    </section>
    <div class="relative z-20 -mt-28 h-[180px] w-full overflow-hidden sm:-mt-36 sm:h-[260px] lg:-mt-[200px] lg:h-[367.44px] lg:col-span-11">
        <img
            class="pointer-events-none absolute left-1/2 top-0 h-full w-[100vw] max-w-none -translate-x-1/2 sm:w-[1100px] lg:w-[1512px]"
            src={branch.src}
            alt=""
            aria-hidden="true"
            width="1512"
            height="367.44"
        />
    </div>
    <div class="pt-8 lg:col-start-2 lg:col-span-9">
        <h1 class="text-[clamp(2.25rem,11vw,6rem)] leading-[1.02]">Bienvenue <br/>
        dans mon jardin en <span class="accent-title text-primary text-stroke-secondary text-[clamp(3.5rem,13vw,7.25rem)]">effervescence.</span></h1>
    </div>
    <section id="a-propos" class="-mx-4 mt-24 w-[calc(100%+2rem)] bg-primary px-6 py-16 sm:-mx-6 sm:w-[calc(100%+3rem)] sm:px-10 lg:mx-0 lg:w-auto lg:portfolio-grid lg:col-span-11 lg:px-20 lg:py-20">
        <h2 class="mb-16 text-center font-serif text-4xl font-normal leading-none text-base-content sm:text-5xl lg:col-start-2 lg:col-span-9">
            Qui suis-je ?
        </h2>
        <div class="mx-auto grid max-w-7xl items-center gap-12 lg:col-start-2 lg:col-span-9 lg:grid-cols-2 lg:gap-20">
            <p class="font-serif text-[clamp(1.75rem,8vw,3rem)] font-normal leading-[1.1] text-base-content sm:text-5xl">
                Mon but final, créer des mondes uniques<br />
                et transformer chaque idée en une réalité.
            </p>
            <div class="flex flex-col items-start gap-12">
                <p class="max-w-xl text-base leading-relaxed text-base-content">
                    En MMI, je relie création graphique, développement web et
                    image en mouvement. Mon approche part d’une idée simple :
                    donner à chaque projet une atmosphère qui lui appartient
                    vraiment.
                </p>
                <div class="flex flex-wrap gap-8">
                    <Button color="secondary" elevated href="/competences">
                        Mes Compétences
                    </Button>
                    <Button color="secondary" elevated href="/cv.pdf" download="CV-Luna-Gouraud.pdf">
                        Mon CV
                    </Button>
                </div>
            </div>
        </div>
    </section>
    <section class="-mx-4 w-[calc(100%+2rem)] px-6 py-20 sm:-mx-6 sm:w-[calc(100%+3rem)] sm:px-10 lg:mx-0 lg:w-auto lg:portfolio-grid lg:col-span-11 lg:px-20 lg:py-28" aria-labelledby="projets-accueil-title">
        <div class="mx-auto max-w-7xl lg:col-start-2 lg:col-span-9">
            <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
                <h2
                    id="projets-accueil-title"
                    class="font-serif text-4xl font-normal leading-none text-primary sm:text-5xl"
                >
                    Mes projets
                </h2>
                <a
                    href="/projets"
                    class="text-base-content underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70"
                >
                    Voir tous les projets
                </a>
            </div>
            <Projets showFilters={false} limit={3} />
        </div>
    </section>
    <section id="contact" class="contact-section -mx-4 w-[calc(100%+2rem)] sm:-mx-6 sm:w-[calc(100%+3rem)] lg:mx-0 lg:w-auto lg:portfolio-grid lg:col-span-11">
        <h2 id="contact-title" class="lg:col-start-2 lg:col-span-9">
            Construisons quelque chose<br />
            <span class="contact-accent">ensemble.</span>
        </h2>
        <div class="contact-links lg:col-start-2 lg:col-span-9">
            <p>
                écrivez moi :
                <a class="contact-email" href="mailto:luna.gouraud@outlook.fr">
                    luna.gouraud@outlook.fr
                </a>
            </p>
            <p>
                ou retrouvez moi sur
                <a class="contact-linkedin" href="https://www.linkedin.com/in/luna-gouraud">
                    linkedin
                </a>
            </p>
        </div>
    </section>
</Layout>
<script>
    import "@google/model-viewer";
</script>
