---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import trees from "../assets/trees.glb";
import branch from "../assets/branche.svg";
---
<Layout title="Acceuil" bodyClass="home-page">
    <section class="relative z-0 h-screen w-full overflow-hidden">
        <model-viewer
            class="absolute inset-x-0 top-0 z-0 block h-[calc(100%+40px)] w-full"
            src={trees}
            alt="Modèle 3D d'arbres"
            camera-controls
            camera-orbit="0deg 80deg 2m"
            camera-target="0m 0.4m 0m"
            min-camera-orbit="-8deg 76deg 2.5m"
            max-camera-orbit="8deg 80deg 2m"
            disable-zoom
            touch-action="pan-y"
            shadow-intensity="1"
        ></model-viewer>
    </section>
    <div class="relative z-20 -mt-[200px] h-[367.44px] w-full">
        <img
            class="pointer-events-none absolute left-1/2 top-0 h-[367.44px] w-[1512px] max-w-none -translate-x-1/2"
            src={branch.src}
            alt=""
            aria-hidden="true"
            width="1512"
            height="367.44"
        />
    </div>
    <div class="whitespace-nowrap lg:portfolio-grid lg:col-start-1">
        <h1>Bienvenue <br/>
        dans mon jardin en <span class="accent-title text-primary text-stroke-secondary">effervescence.</span></h1>
    </div>
    <section id="a-propos" class="mt-24 bg-primary px-6 py-16 sm:px-10 lg:px-20 lg:py-20">
        <h2 class="mb-16 text-center font-serif text-4xl font-normal leading-none text-base-content sm:text-5xl">
            Qui suis-je ?
        </h2>
        <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
            <p class="font-serif text-4xl font-normal leading-[1.1] text-base-content sm:text-5xl">
                Mon but final, créer des mondes uniques<br />
                et transformer chaque idée en une réalité.
            </p>
            <div class="flex flex-col items-start gap-12">
                <p class="max-w-xl text-base leading-relaxed text-base-content">
                    En MMI, je relie création graphique, développement web et
                    image en mouvement. Mon approche part d’une idée simple :
                    donner à chaque projet une atmosphère qui lui appartient
                    vraiment.
                </p>
                <div class="flex flex-wrap gap-8">
                    <Button color="secondary" elevated href="/competences">
                        Mes Compétences
                    </Button>
                    <Button color="secondary" elevated href="/cv.pdf">
                        Mon CV
                    </Button>
                </div>
            </div>
        </div>
    </section>
    <section id="contact" class="contact-section">
        <h2 id="contact-title">
            Construisons quelque chose<br />
            <span class="contact-accent">ensemble.</span>
        </h2>
        <div class="contact-links">
            <p>
                écrivez moi :
                <a class="contact-email" href="mailto:luna.gouraud@outlook.fr">
                    luna.gouraud@outlook.fr
                </a>
            </p>
            <p>
                ou retrouvez moi sur
                <a class="contact-linkedin" href="https://www.linkedin.com/in/luna-gouraud">
                    linkedin
                </a>
            </p>
        </div>
    </section>
</Layout>
<script>
    import "@google/model-viewer";
</script>
