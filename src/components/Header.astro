---
import Button from "./Button.astro";
---

<header class="flex flex-wrap items-center text-base lg:portfolio-grid w-[94.5rem] h-[115px]">
  <a class="lg:col-start-2" href="/">Luna Gouraud</a>
  <p class="whitespace-nowrap lg:col-start-3 text-accent">Étudiante en MMI</p>

  <nav class="flex items-center gap-7 lg:col-start-7 lg:col-span-5" aria-label="Navigation principale">
    
    <div class="flex items-center gap-7">
      <a href="/projets">Projets</a>
      <a href="/a-propos">A propos</a>
      <Button color="accent" outline href="/contact">
        Contact
      </Button>
    </div>
    <div aria-label="Choisir la langue">
      <div class="join">
        <button >FR</button>
        <span class="mx-[10px]" aria-hidden="true">|</span>
        <button>EN</button>
      </div>
    </div>
  </nav>
</header>