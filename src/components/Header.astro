---
import Button from "./Button.astro";
---

<header class="top-0 z-20 mx-auto mb-[16px] flex h-[115px] w-[94.5rem] max-w-full flex-wrap items-center text-base lg:portfolio-grid">
  <a class="lg:col-start-2 bodys" href="/">Luna Gouraud</a>
  <p class="whitespace-nowrap lg:col-start-3 text-accent bodyl">Étudiante en MMI</p>

  <nav class="flex items-center gap-7 lg:col-start-7 lg:col-span-5" aria-label="Navigation principale">
    
    <div class="flex items-center gap-7 bodyl">
      <a href="/projets">Projets</a>
      <a href="/#a-propos">A propos</a>
      <Button color="accent" href="/#contact">
        Contact
      </Button>
    </div>
    <div aria-label="Choisir la langue">
      <div class="join bodyl">
        <button >FR</button>
        <span class="mx-[10px]" aria-hidden="true">|</span>
        <button>EN</button>
      </div>
    </div>
  </nav>
</header>